package smartsuite.app.crypto;

import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import com.fasterxml.jackson.databind.ObjectMapper;

import smartsuite.app.api.outbound.service.ApiSenderService;

@Service
public class EgCryptoService {

	static final Logger LOG = LoggerFactory.getLogger(EgCryptoService.class);
	
	@Value("#{apiProperties['eg.item']}")
	private String egItem;
	
	
	@Autowired
	private ApiSenderService apiSenderService;
	
	@Autowired
	ObjectMapper objectMapper;

	public List<String> enc(String plain) throws Exception {
		return this.call(Arrays.asList(plain.split(",")), "enc");
	}
	
	public List<String> enc(List<String> plainArr) throws Exception {
		return this.call(plainArr, "enc");
	}
	
	public List<String> dec(String enc) throws Exception {
		return this.call(Arrays.asList(enc.split(",")), "dec");
	}
	
	public List<String> dec(List<String> encArr) throws Exception {
		return this.call(encArr, "dec");
	}
	
	public List<String> call(List<String> paramList, String type) throws Exception {
		LOG.info("[crypto] EG call type={}, size={}",type, paramList.size());
		Map<String, Object> result = new HashMap<String, Object>();
		Map<String, Object> param = new HashMap<String, Object>();
		
		param.put("item", egItem);
		param.put("type", type.toLowerCase());
		
		param.put("input", paramList);
		
		result = apiSenderService.call("EG_ENC", param, "EG");
		
		if(!(boolean) result.get("result")) {
			String errCode = (String) result.get("value");
			throw new Exception("EG 암복호화 오류 발생 : " + errCode);
		}
		
		List<String> resultList = null;
		
		Object v = result.get("value");
		if(v instanceof List<?> list) {
			resultList = (List<String>) list;
		}
		
		return resultList;
	}
	

}
