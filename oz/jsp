<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div id="OZViewer" style="width:100%;height:100vh;"></div>

<script type="application/json" id="ozData">${dataJson}</script>
<script src="/ozrept/ozhviewer/ozviewer.js"></script>   <!-- 실제 제공받은 경로로 -->
<script>
var OZ_REPORT = '<c:out value="${ozrPath}" />';
var OZ_DATA   = document.getElementById('ozData').textContent;  // JSON 문자열 그대로

start_ozjs('OZViewer', '/ozrept/ozhviewer/');

function SetOZParamters_OZViewer() {
  var oz = document.getElementById('OZViewer');
  oz.sendToActionScript('connection.servlet', '/ozrept/server');
  oz.sendToActionScript('connection.reportname', OZ_REPORT);
  oz.sendToActionScript('connection.inputjson', OZ_DATA);   // ★ 키는 OZ 9 매뉴얼로 확인
  return true;
}
</script>