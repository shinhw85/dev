@Controller
@RequestMapping("/report")
public class ReportViewController {

    private static final Pattern ID_PATTERN = Pattern.compile("^[A-Za-z0-9_]{1,50}$");
    private final ObjectMapper objectMapper;

    public ReportViewController(ObjectMapper objectMapper) {
        this.objectMapper = objectMapper;
    }

    @PostMapping("/view")
    public String view(@RequestParam("reportId") String reportId,
                       @RequestParam(value = "params", defaultValue = "{}") String params,
                       Model model) throws JsonProcessingException {
        // 필수값 직접 검증
        if (reportId == null || !ID_PATTERN.matcher(reportId).matches()) {
            throw new IllegalArgumentException("reportId 형식 오류");
        }
        objectMapper.readTree(params);  // JSON 형식 검증 (실패 시 예외)

        model.addAttribute("reportId", reportId);
        // <script> 안에 직접 출력하므로 '<' 이스케이프 (XSS/스크립트 종료 방지)
        model.addAttribute("paramsJson",
            params.replace("<", "\\u003c").replace("\u2028", "\\u2028").replace("\u2029", "\\u2029"));
        return "report/viewer";   // viewResolver 설정에 맞게 경로 조정
    }
}