@Component
public class PoOrderReportProvider implements ReportDataProvider {

    private final SqlSessionTemplate sqlSession;

    public PoOrderReportProvider(SqlSessionTemplate sqlSession) {
        this.sqlSession = sqlSession;
    }

    @Override public String reportId() { return "PO_ORDER"; }
    @Override public String ozrPath()  { return "/po/order.ozr"; }

    @Override
    public Object getData(Map<String, Object> params) {
        Object poNo = params.get("poNo");
        if (poNo == null || poNo.toString().isBlank()) {
            throw new IllegalArgumentException("poNo는 필수입니다.");
        }

        Map<String, Object> header = sqlSession.selectOne("report.selectPoHeader", params);
        if (header == null) {
            throw new IllegalArgumentException("발주 정보가 없습니다: " + poNo);
        }
        List<Map<String, Object>> items = sqlSession.selectList("report.selectPoItems", params);

        // 공통 규칙: {"header": {...}, "items": [...]}
        Map<String, Object> data = new LinkedHashMap<>();
        data.put("header", header);
        data.put("items", items);
        return data;
    }
}