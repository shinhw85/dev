package smartsuite.mybatis;

import java.util.List;

/** EG 암복호화 호출 추상화. List 단위(배치)가 기본이고, 단건은 배치 호출로 위임한다. */
public interface CryptoClient {

    List<String> encrypt(List<String> plains);

    List<String> decrypt(List<String> ciphers);

    default String encrypt(String plain) {
        return encrypt(List.of(plain)).get(0);
    }

    default String decrypt(String cipher) {
        return decrypt(List.of(cipher)).get(0);
    }
}
