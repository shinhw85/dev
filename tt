public class CryptoTargets {

    private final Map<String, Set<String>> exact = new HashMap<>();
    private final Map<String, Set<String>> prefix = new HashMap<>();

    public CryptoTargets(Properties props) {
        props.forEach((k, v) -> {
            String id = k.toString().trim();
            Set<String> keys = Arrays.stream(v.toString().split(","))
                    .map(s -> s.trim().toLowerCase())      // 대소문자 무시 비교용
                    .filter(s -> !s.isEmpty())
                    .collect(Collectors.toSet());
            if (id.endsWith(".*")) prefix.put(id.substring(0, id.length() - 1), keys); // "ns."
            else exact.put(id, keys);
        });
    }

    /** 대상이 아니면 null */
    public Set<String> find(String statementId) {
        Set<String> keys = exact.get(statementId);
        if (keys != null) return keys;
        for (Map.Entry<String, Set<String>> e : prefix.entrySet()) {
            if (statementId.startsWith(e.getKey())) return e.getValue();
        }
        return null;
    }
}


@Bean
public CryptoTargets cryptoTargets() throws IOException {
    Properties p = new Properties();
    try (InputStream in = getClass().getResourceAsStream("/crypto-targets.properties");
         Reader r = new InputStreamReader(in, StandardCharsets.UTF_8)) {
        p.load(r);
    }
    return new CryptoTargets(p);
}

@Bean
public CryptoInterceptor cryptoInterceptor(CryptoClient client, CryptoTargets targets) {
    return new CryptoInterceptor(client, targets);
}