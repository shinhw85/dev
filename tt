private static final int PAGE_SIZE = 10;

	@Transactional(rollbackFor = Exception.class)
	public void callMatl(Map<String, Object> param) {
	    String lastKey = null;
	    
	    try {
		    while (true) {
		        Map<String, Object> q = new HashMap<>(param);
		        q.put("pageSize", PAGE_SIZE);
		        q.put("lastKey", lastKey);
	
		        List<Map<String, Object>> matlList = apiSapmdModelRepository.selectIF_D4MDZ0100_MATL(q);
		        if (matlList == null || matlList.isEmpty()) break;
	
		        for (Map<String, Object> matlMap : matlList) {
		            processMatl(matlMap);
		        }
	
		        lastKey = String.valueOf(matlList.get(matlList.size() - 1).get("if_doc_id"));
		        if (matlList.size() < PAGE_SIZE) break;
		    }
	    } catch (Exception e) {
	        LOG.error("model 마이그레이션 실패", e);
	        throw new RuntimeException(e); 
	    }		 
	}

	private void processMatl(Map<String, Object> matlMap) throws Exception {
        Map<String, Object> itemMap = new HashMap<>(matlMap);
		
		List<Map<String, Object>> matldescList = apiSapmdModelRepository.selectIF_D4MDZ0100_MATLDESC(matlMap);
		if(matldescList == null){
			LOG.debug("empty if statements");					
		}else{
			for(Map<String, Object> matldescMap : matldescList) {
				itemMap.put("maktx", matldescMap.get("maktx"));
			}
		}
		
