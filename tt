//					LOG.debug("empty if statements");				
//				}else{
//					for(Map<String, Object> matlplntMap : matlplntList) {
//					}
//				}
		
		
		List<Map<String, Object>> matlzappmfrList = apiSapmdModelRepository.selectIF_D4MDZ0100_MATLZAPPMFR(matlMap);
		if(matlzappmfrList == null){
			LOG.debug("empty if statements");				
		}else{
			for(Map<String, Object> matlzappmfrMap : matlzappmfrList) {
				itemMap.put("mfrnr", matlzappmfrMap.get("mfrnr"));
				itemMap.put("mfrpn", matlzappmfrMap.get("mfrpn"));
				matlzappmfrMap.put("item_cd", itemMap.get("matnr"));
				apiSapmdModelRepository.mergeModelVdName(matlzappmfrMap);
				
//						List<Map<String, Object>> matlzappmfrzuseList = apiSapmdModelRepository.selectIF_D4MDZ0100_MATLZAPPMFRZUSE(matlzappmfrMap);
