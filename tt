    type: 'POST',
    contentType: 'application/json',
    data: JSON.stringify(param),
    success: function (res) {
      var oz = document.getElementById('OZViewer');
      // 리포트 경로, 데이터 JSON을 파라미터로 전달
      // (OZ 버전에 따라 start_ozviewer / OZViewer 객체 방식이 다름)
    }
  });
}
</script>