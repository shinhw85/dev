			,itemcat_lvl_3_cd    
			,itemcat_lvl_4_cd    
			,itemcat_cd    
			,item_spec       	
			,uom_ccd      	
			,rep_item_cd_yn
			,use_yn      	
			,regr_id      	
			,reg_dttm
			,modr_id      	
			,mod_dttm
			,GROSS_WEIGHT	
			,WEIGHT_UNIT	
			,NET_WEIGHT	
			,VOLUME		
			,DEL_YN		
			,LNGTH		
			,WDTH			
			,HGHT			
			,LNGTH_UNIT	
			,EAN_CD		
			,MAT_TYP		
			,VOL_UNIT		
			,ZZDOKAR		
			,ZZDOKNR		
			,ZZDOKTL		
			,ZZDOKVR		
