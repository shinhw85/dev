-- 기준: 키(TEN_ID 포함)별로 REG_DTTM이 가장 최신인 1건만 남기고 나머지를 삭제 대상으로 추출
-- 동일 REG_DTTM이면 ctid가 큰 행을 남김

------------------------------------------------------------
-- 1) 조회(삭제 대상 확인)
------------------------------------------------------------
-- PROJECT
SELECT x.*
  FROM (SELECT t.*,
               ROW_NUMBER() OVER (PARTITION BY t.ten_id, t.pspid, t.sjconfyn, t.zzptype
                                  ORDER BY t.reg_dttm DESC NULLS LAST, t.ctid DESC) AS rn
          FROM project t) x
 WHERE x.rn > 1;

-- PROJECT_WBS
SELECT x.*
  FROM (SELECT t.*,
               ROW_NUMBER() OVER (PARTITION BY t.ten_id, t.pspid, t.pspnr
                                  ORDER BY t.reg_dttm DESC NULLS LAST, t.ctid DESC) AS rn
          FROM project_wbs t) x
 WHERE x.rn > 1;

-- PROJECT_ATTR
SELECT x.*
  FROM (SELECT t.*,
               ROW_NUMBER() OVER (PARTITION BY t.ten_id, t.posid, t.bstypes, t.fkstl
                                  ORDER BY t.reg_dttm DESC NULLS LAST, t.ctid DESC) AS rn
          FROM project_attr t) x
 WHERE x.rn > 1;

------------------------------------------------------------
-- 2) 삭제 (조회 결과 확인 후 실행, 백업/트랜잭션 권장)
------------------------------------------------------------
DELETE FROM project
 WHERE ctid IN (SELECT x.ctid
                  FROM (SELECT t.ctid,
                               ROW_NUMBER() OVER (PARTITION BY t.ten_id, t.pspid, t.sjconfyn, t.zzptype
                                                  ORDER BY t.reg_dttm DESC NULLS LAST, t.ctid DESC) AS rn
                          FROM project t) x
                 WHERE x.rn > 1);

DELETE FROM project_wbs
 WHERE ctid IN (SELECT x.ctid
                  FROM (SELECT t.ctid,
                               ROW_NUMBER() OVER (PARTITION BY t.ten_id, t.pspid, t.pspnr
                                                  ORDER BY t.reg_dttm DESC NULLS LAST, t.ctid DESC) AS rn
                          FROM project_wbs t) x
                 WHERE x.rn > 1);

DELETE FROM project_attr
 WHERE ctid IN (SELECT x.ctid
                  FROM (SELECT t.ctid,
                               ROW_NUMBER() OVER (PARTITION BY t.ten_id, t.posid, t.bstypes, t.fkstl
                                                  ORDER BY t.reg_dttm DESC NULLS LAST, t.ctid DESC) AS rn
                          FROM project_attr t) x
                 WHERE x.rn > 1);
