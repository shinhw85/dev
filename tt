						if("MCT00060".equals(matlcharasgnMap.get("atnam")) && "M1".equals(matlcharasgnMap.get("atwrt"))){
							itemMap.put("serial_yn", "Y");
						}
						//MDG(박경인 차장)요청으로 부품 품목에 대한 기기이력대상체크로직 추가함.
						if("PCT00145".equals(matlcharasgnMap.get("atnam")) && "P1".equals(matlcharasgnMap.get("atwrt"))){
							itemMap.put("serial_yn", "Y");
						}
