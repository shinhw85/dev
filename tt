					itemMap.put("serial_yn", "Y");
				}
				//MDG(박경인 차장)요청으로 설비 품목에 대한 기기이력대상체크로직 추가함.
				if("ECT00034".equals(matlcharasgnMap.get("atnam")) && "E1".equals(matlcharasgnMap.get("atwrt"))){
					itemMap.put("serial_yn", "Y");
				}
			}
		}
		
		
//				List<Map<String, Object>> matlunitList = apiSapmdModelRepository.selectIF_D4MDZ0100_MATLUNIT(matlMap);
