			}
		}
		
		if(StringUtils.isNotEmpty((String) itemMap.get("matnr"))) {
			apiSapmdModelRepository.mergeModel(itemMap);
			
		}
	}




<!-- 	item([CMS] 품목 테이블) Merge로 저장 -->
	<insert id="mergeModel" parameterType="map">
	/*	apiSapmdModel.mergeModel :  item([CMS] 품목 테이블) Merge로 저장	*/
		MERGE INTO item A
		USING (
			SELECT  #{p.matnr}        AS matnr
			) B
		ON (
			A.ten_id		= #{g.tenant}
			AND A.item_cd 	= #{p.matnr}
		)
		WHEN MATCHED THEN
			UPDATE SET
				 item_nm		 	= #{p.maktx}
				,item_simword  		= #{p.zzname}
				,itemcat_lvl_1_cd	= SUBSTR(#{p.matkl}, 1 ,2)
				,itemcat_lvl_2_cd	= SUBSTR(#{p.matkl}, 1 ,4)
				,itemcat_lvl_3_cd	= SUBSTR(#{p.matkl}, 1 ,6)
				,itemcat_lvl_4_cd	= SUBSTR(#{p.matkl}, 1 ,8)
				,itemcat_cd       	= #{p.matkl}
				,item_spec       	= #{p.zzdesc}
				,uom_ccd      		= #{p.meins}
				,use_yn      		= 'Y'
				,sts				= 'U'
				,modr_id      		= 'MDZ'
				,mod_dttm         	= #{g.now}
				,GROSS_WEIGHT		= #{p.brgew}::numeric
				,WEIGHT_UNIT		= #{p.gewei}
				,NET_WEIGHT			= #{p.ntgew}::numeric
				,VOLUME				= #{p.volum}::numeric
				,DEL_YN				= coalesce(#{p.lvorm}, 'N')
				,LNGTH				= #{p.laeng}::numeric
				,WDTH				= #{p.breit}::numeric
				,HGHT				= #{p.hoehe}::numeric
				,LNGTH_UNIT			= #{p.meabm}
				,EAN_CD				= #{p.ean11}
				,MAT_TYP			= #{p.mtart}
				,VOL_UNIT			= #{p.voleh}
				,ZZDOKAR			= #{p.zzdokar}
				,ZZDOKNR			= #{p.zzdoknr}
				,ZZDOKTL			= #{p.zzdoktl}
				,ZZDOKVR			= #{p.zzdokvr}
				,LABOR				= #{p.labor}
