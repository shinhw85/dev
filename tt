private static final int PAGE_SIZE = 1000; // 10은 너무 작음

public void callMatl(Map<String, Object> param) {   // @Transactional 제거
    String lastKey = null;
    while (true) {
        Map<String, Object> q = new HashMap<>(param);
        q.put("pageSize", PAGE_SIZE);
        q.put("lastKey", lastKey);

        String nextKey = apiSapmdModelRepository.selectMatlPageLastKey(q);
        if (nextKey == null) break;

        txTemplate.executeWithoutResult(s -> {      // TransactionTemplate 주입
            apiSapmdModelRepository.mergeModelVdNameBatch(q);
            apiSapmdModelRepository.mergeModelBatch(q);
        });
        lastKey = nextKey;
    }
}




<!-- 페이지 대상 (공통) -->
<sql id="matlPage">
  SELECT DISTINCT ON (matnr) *
    FROM (
      SELECT *
        FROM IF_D4MDZ0100_MATL
       WHERE TEN_ID = #{g.tenant}
         AND TO_CHAR(REG_DTTM, 'YYYYMMDD') BETWEEN #{p.from_dt} AND #{p.to_dt}
         <if test="p.lastKey != null">AND IF_DOC_ID > #{p.lastKey}</if>
       ORDER BY IF_DOC_ID
       LIMIT #{p.pageSize}
    ) t
   WHERE COALESCE(matnr, '') <> ''
   ORDER BY matnr, if_doc_id DESC   -- 같은 matnr이면 마지막 doc이 우선
</sql>

<!-- 다음 lastKey만 조회 -->
<select id="selectMatlPageLastKey" parameterType="map" resultType="string">
  SELECT MAX(IF_DOC_ID) FROM (
    SELECT IF_DOC_ID FROM IF_D4MDZ0100_MATL
     WHERE TEN_ID = #{g.tenant}
       AND TO_CHAR(REG_DTTM, 'YYYYMMDD') BETWEEN #{p.from_dt} AND #{p.to_dt}
       <if test="p.lastKey != null">AND IF_DOC_ID > #{p.lastKey}</if>
     ORDER BY IF_DOC_ID
     LIMIT #{p.pageSize}
  ) t
</select>

<!-- 협력사 자재 -->
<insert id="mergeModelVdNameBatch" parameterType="map">
  MERGE INTO esivdmt A
  USING (
    SELECT DISTINCT ON (z.matnr, z.mfrnr) z.matnr AS item_cd, z.mfrnr, z.mfrpn
      FROM IF_D4MDZ0100_MATLZAPPMFR z
     WHERE z.TEN_ID = #{g.tenant}
       AND z.matnr IN (SELECT matnr FROM (<include refid="matlPage"/>) m)
     ORDER BY z.matnr, z.mfrnr
  ) B
  ON (A.ten_id = #{g.tenant} AND A.vd_cd = B.mfrnr AND A.item_cd = B.item_cd)
  WHEN MATCHED THEN
    UPDATE SET mfrpn = B.mfrpn, mod_id = 'MDZ', modr_dttm = #{g.now}
  WHEN NOT MATCHED THEN
    INSERT (ten_id, item_cd, vd_cd, mfrpn, reg_id, regr_dttm, mod_id, modr_dttm)
    VALUES (#{g.tenant}, B.item_cd, B.mfrnr, B.mfrpn, 'MDZ', #{g.now}, 'MDZ', #{g.now})
</insert>

<!-- 품목 -->
<insert id="mergeModelBatch" parameterType="map">
  MERGE INTO item A
  USING (
    SELECT m.*,
           d.maktx,
           f.mfrpn,
           CASE WHEN EXISTS (
                SELECT 1 FROM IF_D4MDZ0100_MATLCHARASGN c
                 WHERE c.TEN_ID = m.ten_id AND c.matnr = m.matnr
                   AND ( (c.atnam = 'MCT00060' AND c.atwrt = 'M1')
                      OR (c.atnam = 'PCT00145' AND c.atwrt = 'P1')
                      OR (c.atnam = 'ECT00034' AND c.atwrt = 'E1') )
           ) THEN 'Y' ELSE 'N' END AS serial_yn
      FROM (<include refid="matlPage"/>) m
      LEFT JOIN LATERAL (
            SELECT maktx FROM IF_D4MDZ0100_MATLDESC
             WHERE TEN_ID = m.ten_id AND matnr = m.matnr
             ORDER BY spras DESC LIMIT 1) d ON true
      LEFT JOIN LATERAL (
            SELECT mfrpn FROM IF_D4MDZ0100_MATLZAPPMFR
             WHERE TEN_ID = m.ten_id AND matnr = m.matnr
             ORDER BY mfrnr DESC LIMIT 1) f ON true
  ) B
  ON (A.ten_id = #{g.tenant} AND A.item_cd = B.matnr)
  WHEN MATCHED THEN
    UPDATE SET item_nm = B.maktx, item_simword = B.zzname, ...   -- #{p.xxx} → B.xxx
  WHEN NOT MATCHED THEN
    INSERT (...) VALUES (...)                                    -- 동일하게 B.xxx
</insert>