<insert id="mergeModelOorgBatch" parameterType="map">
	  MERGE INTO item_oorg A
	  USING (
	    SELECT i.item_cd
	      FROM item i
	     WHERE i.ten_id = #{g.tenant}
	       AND i.md_pt_cls = 'M'
	       AND TO_CHAR(REG_DTTM, 'YYYYMMDD') BETWEEN #{p.from_dt} AND #{p.to_dt}
	  ) B
	  ON (A.ten_id = #{g.tenant}
	      AND A.oorg_cd = 'IOY1AO'
	      AND A.item_cd = B.item_cd)
	  WHEN MATCHED THEN
	  	UPDATE SET
	    	 modr_id            = 'MDZ'
	        ,mod_dttm           = #{g.now}
	  WHEN NOT MATCHED THEN
	    INSERT (ten_id, oorg_cd, item_cd, item_ldtm, regr_id)
	    VALUES (#{g.tenant}, 'IOY1AO', B.item_cd, 0, 'MDZ')
	</insert>

