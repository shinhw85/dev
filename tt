            case FORMULA:
                return fmt.formatCellValue(c);
            default:
                String s = c.getStringCellValue().trim();
                return s.isEmpty() ? null : s;
        }
    }
}


int insertBatch(@Param("table") String table,
                @Param("cols") List<String> cols,
                @Param("rows") List<List<Object>> rows);



