WITH RECURSIVE chain AS (
    SELECT u.usr_id, u.dh_usr_id, 0 AS lvl, ARRAY[u.usr_id] AS path
    FROM usr u
    WHERE u.usr_id = #{usrId}

    UNION ALL

    SELECT p.usr_id, p.dh_usr_id, c.lvl + 1, c.path || p.usr_id
    FROM chain c
    JOIN usr p ON p.usr_id = c.dh_usr_id
    WHERE c.lvl < #{depth}
      AND p.usr_id <> ALL(c.path)   -- 순환/자기참조 방지
)
SELECT *
FROM chain
WHERE lvl = #{depth};