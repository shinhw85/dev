<!-- 	ESMMTMN(업체 모델명 테이블) Merge로 저장 -->
	<insert id="mergeModelVdName" parameterType="map">
	/*	apiSapmdModel.mergeModelVdName :  esivdmt(협력사별 자재 테이블) Merge로 저장	*/
		MERGE INTO esivdmt A
		USING
		(SELECT  #{p.item_cd}        AS matnr
			) B
		ON
		(
			A.ten_id		= #{g.tenant}
			AND A.vd_cd		= #{p.mfrnr}
			AND A.item_cd	= B.matnr
		)
		WHEN MATCHED THEN
			UPDATE SET
				 mfrpn		= #{p.mfrpn}
				,mod_id		= 'MDZ'
				,modr_dttm	= #{g.now}
		WHEN NOT MATCHED THEN
		INSERT
		( 	ten_ID
			,item_cd
			,vd_cd
			,mfrpn
			,reg_id
			,regr_dttm
			,mod_id
			,modr_dttm
		)
		VALUES
		( 	 #{g.tenant}
			,#{p.item_cd}
			,#{p.mfrnr}
			,#{p.mfrpn}
			,'MDZ'
			,#{g.now}
			,'MDZ'
			,#{g.now}
		)
	</insert>
	
