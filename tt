import java.util.*;

/**
 * IF_ 테이블(수신 저장된 기존 데이터)과 InfoMap(신규/수정/삭제 반영 값)을
 * 계층형 Map/List 구조로 병합하여 송신용 전문을 만드는 유틸리티.
 *
 * 데이터 표현 규칙
 * - 각 레코드는 Map<String, Object> (LinkedHashMap 사용 필수: 첫 필드를 pseudo-key로 쓰기 위해 순서 보존)
 * - 반복 구조(ADDR[], POSTAL[], TEL[], VENGEN[], COMPANY[] 등)는 List<Map<String, Object>>
 * - 그 외 값은 스칼라(String)
 *
 * 병합 규칙 (사용자 요구사항 3케이스)
 * 1) 신규: ifData가 없음(null/empty) -> infoMap 값으로 전부 채움
 * 2-1) 수정: ifData 존재, infoMap에 해당 키 값이 있으면 그 값으로 override
 * 2-2) 삭제: ifData 존재, infoMap에 해당 키가 빈 값("")으로 세팅되어 있으면 그대로 override
 *      (2-1, 2-2는 "infoMap이 해당 키를 갖고 있으면 override"라는 동일 규칙으로 처리됨.
 *       즉 삭제 여부를 별도 플래그로 구분하지 않고, InfoMap을 준비하는 상위 로직에서
 *       삭제 대상 필드에 빈 문자열을 세팅해서 넘기면 된다)
 *
 * 리스트 항목 매칭 규칙 (SEQ/첫 필드가 고유 키를 보장하지 않는 문제 대응)
 * - ifList의 각 레코드에 대해, infoList 중 "첫번째 필드 값"이 같은(그리고 아직 안 쓰인) 레코드를 찾아 매칭
 * - 매칭되면 재귀 병합(수정), 매칭 안 되면 ifRec을 그대로 유지(해당 infoMap에서 손대지 않은 레코드)
 * - infoList 중 끝까지 매칭 안 된 레코드는 신규 추가 항목으로 뒤에 append
 * - 주의: 첫 필드 값이 null/공백이거나 중복되면 매칭이 애매해질 수 있음.
 *   그런 케이스가 실제로 존재한다면(예: 동일 첫 필드값 중복) 상위 로직에서
 *   InfoMap 준비 시 리스트 순서를 ifList와 1:1로 맞춰서 넘기는 방식으로 우회하는 걸 권장.
 */
public class IfTableMerger {

    /**
     * ifData: IF_ 테이블에서 조회한 기존 구조 (신규 건이면 null 전달 가능)
     * infoMap: 반영할 값 구조 (신규는 전체 값, 수정/삭제는 바뀌는 필드만 있어도 되고
     *          전체를 다시 채워서 넘겨도 됨 - 어느 쪽이든 결과는 동일)
     */
    @SuppressWarnings("unchecked")
    public static Map<String, Object> merge(Map<String, Object> ifData, Map<String, Object> infoMap) {
        Map<String, Object> result = new LinkedHashMap<>();
        Map<String, Object> base = (ifData == null) ? Collections.emptyMap() : ifData;
        Map<String, Object> override = (infoMap == null) ? Collections.emptyMap() : infoMap;

        // 순서 유지: IF데이터 순서 우선 + infoMap에만 있는 신규 키는 뒤에 추가
        Set<String> keys = new LinkedHashSet<>();
        keys.addAll(base.keySet());
        keys.addAll(override.keySet());

        for (String key : keys) {
            Object baseVal = base.get(key);
            Object overrideVal = override.get(key);

            if (baseVal instanceof List || overrideVal instanceof List) {
                result.put(key, mergeList(asList(baseVal), asList(overrideVal)));
            } else if (baseVal instanceof Map || overrideVal instanceof Map) {
                result.put(key, merge(asMap(baseVal), asMap(overrideVal)));
            } else {
                // 스칼라: infoMap이 해당 키를 갖고 있으면(빈 문자열 포함=삭제 케이스) override, 아니면 기존값 유지
                result.put(key, override.containsKey(key) ? overrideVal : baseVal);
            }
        }
        return result;
    }

    @SuppressWarnings("unchecked")
    private static List<Map<String, Object>> mergeList(List<Map<String, Object>> ifList,
                                                         List<Map<String, Object>> infoList) {
        List<Map<String, Object>> result = new ArrayList<>();
        boolean[] infoUsed = new boolean[infoList.size()];

        // 1) ifList 각 레코드에 대해 infoList에서 같은 pseudo-key(첫 필드값)를 가진 레코드를 찾아 병합
        for (Map<String, Object> ifRec : ifList) {
            String ifKey = firstFieldValue(ifRec);
            int matchedIdx = -1;
            if (ifKey != null && !ifKey.isEmpty()) {
                for (int i = 0; i < infoList.size(); i++) {
                    if (infoUsed[i]) continue;
                    if (ifKey.equals(firstFieldValue(infoList.get(i)))) {
                        matchedIdx = i;
                        break;
                    }
                }
            }
            if (matchedIdx >= 0) {
                result.add(merge(ifRec, infoList.get(matchedIdx)));
                infoUsed[matchedIdx] = true;
            } else {
                // infoMap에서 이 레코드를 건드리지 않음 -> 기존값 그대로
                result.add(merge(ifRec, null));
            }
        }

        // 2) infoList 중 끝까지 매칭 안 된 레코드 = 신규 추가 항목
        for (int i = 0; i < infoList.size(); i++) {
            if (!infoUsed[i]) {
                result.add(merge(null, infoList.get(i)));
            }
        }
        return result;
    }

    /** 레코드의 첫번째 필드 값을 pseudo-key로 사용 (LinkedHashMap 순서 보존 전제) */
    private static String firstFieldValue(Map<String, Object> rec) {
        if (rec == null || rec.isEmpty()) return null;
        Object v = rec.values().iterator().next();
        return v == null ? null : String.valueOf(v);
    }

    @SuppressWarnings("unchecked")
    private static List<Map<String, Object>> asList(Object o) {
        if (o == null) return Collections.emptyList();
        return (List<Map<String, Object>>) o;
    }

    @SuppressWarnings("unchecked")
    private static Map<String, Object> asMap(Object o) {
        if (o == null) return Collections.emptyMap();
        return (Map<String, Object>) o;
    }

    // ------------------------------------------------------------------
    // 사용 예시
    // ------------------------------------------------------------------
    public static void main(String[] args) {
        // 1) 신규 케이스: IF_ 테이블 데이터 없음 -> InfoMap 전체가 그대로 결과가 됨
        Map<String, Object> infoMapNew = new LinkedHashMap<>();
        infoMapNew.put("BP_HEADER", null);       // 신규시 null
        infoMapNew.put("ZZSRMCD", "SRM001");

        Map<String, Object> addr = new LinkedHashMap<>();
        addr.put("ADDRNO", null);                // 신규시 null
        Map<String, Object> postal = new LinkedHashMap<>();
        postal.put("NATION", "KR");
        postal.put("POST_CODE1", "12345");
        postal.put("CITY1", "Seoul");
        addr.put("POSTAL", Collections.singletonList(postal));
        infoMapNew.put("ADDR", Collections.singletonList(addr));

        Map<String, Object> newResult = merge(null, infoMapNew);
        System.out.println(newResult);

        // 2) 기존 존재 + 수정 케이스: ifData 기반에 infoMap 값으로 override
        Map<String, Object> ifDataExisting = new LinkedHashMap<>();
        ifDataExisting.put("BP_HEADER", "BP0001");
        ifDataExisting.put("ZZSRMCD", "SRM001");

        Map<String, Object> infoMapUpdate = new LinkedHashMap<>();
        infoMapUpdate.put("ZZSRMCD", "SRM999"); // 이 값만 override

        Map<String, Object> updateResult = merge(ifDataExisting, infoMapUpdate);
        System.out.println(updateResult); // ZZSRMCD가 SRM999로 override됨

        // 3) 삭제 케이스: infoMap에 빈 문자열로 override
        Map<String, Object> infoMapDelete = new LinkedHashMap<>();
        infoMapDelete.put("ZZSRMCD", ""); // 삭제 = 빈값으로 override

        Map<String, Object> deleteResult = merge(ifDataExisting, infoMapDelete);
        System.out.println(deleteResult); // ZZSRMCD가 빈 문자열로 override됨
    }
}
