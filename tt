	<insert id="insertProject" parameterType="map">
	/*	apiSapps.insertProject (MERGE) :  	*/
		MERGE INTO PROJECT T
		USING (SELECT 1) S
		   ON (T.TEN_ID = #{g.tenant}
			 AND T.PSPID = #{p.pspid}
			 AND T.SJCONFYN = #{p.sjconfyn}
			 AND T.ZZPTYPE = #{p.zzptype})
		WHEN MATCHED THEN
			UPDATE SET
				ZZCTYPE = #{p.zzctype},
				OBJECT_ID = #{p.object_id},
				ZZCNTRTNM = #{p.zzcntrtnm},
				ZZCNTRTNM_B = #{p.zzcntrtnm_b},
				POST1 = #{p.post1},
				PROFL = #{p.profl},
				PLFAZ = #{p.plfaz},
				PLSEZ = #{p.plsez},
				ZTEHT = #{p.zteht},
				VKOKR = #{p.vkokr},
				VBUKR = #{p.vbukr},
				VGSBR = #{p.vgsbr},
				WERKS = #{p.werks},
				FUNC_AREA = #{p.func_area},
				PRCTR = #{p.prctr},
				PWHIE = #{p.pwhie},
				STTXT_INT = #{p.sttxt_int},
				STTXT_EXT = #{p.sttxt_ext},
				ERNAM = #{p.ernam},
				ER_KR_TIMESTAMP = #{p.er_kr_timestamp},
				AENAM = #{p.aenam},
				AE_KR_TIMESTAMP = #{p.ae_kr_timestamp}
		WHEN NOT MATCHED THEN
			INSERT
				(TEN_ID,
				 PROJECT_UUID,
				 PSPID,
				 SJCONFYN,
				 ZZPTYPE,
				 ZZCTYPE,
				 OBJECT_ID,
				 ZZCNTRTNM,
				 ZZCNTRTNM_B,
				 POST1,
				 PROFL,
				 PLFAZ,
				 PLSEZ,
				 ZTEHT,
				 VKOKR,
				 VBUKR,
				 VGSBR,
				 WERKS,
				 FUNC_AREA,
				 PRCTR,
				 PWHIE,
				 STTXT_INT,
				 STTXT_EXT,
				 ERNAM,
				 ER_KR_TIMESTAMP,
				 AENAM,
				 AE_KR_TIMESTAMP,
				 REGR_ID,
				 REG_DTTM)
			VALUES
				(#{g.tenant},
				 #{p.project_uuid},
				 #{p.pspid},
				 #{p.sjconfyn},
				 #{p.zzptype},
				 #{p.zzctype},
				 #{p.object_id},
				 #{p.zzcntrtnm},
				 #{p.zzcntrtnm_b},
				 #{p.post1},
				 #{p.profl},
				 #{p.plfaz},
				 #{p.plsez},
				 #{p.zteht},
				 #{p.vkokr},
				 #{p.vbukr},
				 #{p.vgsbr},
				 #{p.werks},
				 #{p.func_area},
				 #{p.prctr},
				 #{p.pwhie},
				 #{p.sttxt_int},
				 #{p.sttxt_ext},
				 #{p.ernam},
				 #{p.er_kr_timestamp},
				 #{p.aenam},
				 #{p.ae_kr_timestamp},
				 'IF',
				 #{g.now})
	</insert>

