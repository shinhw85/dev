<insert id="mergeEquipOorgBatch" parameterType="map">
  MERGE INTO item_oorg A
  USING (
    SELECT m.matnr AS item_cd
      FROM (<include refid="equipPage"/>) m
     WHERE EXISTS (
            SELECT 1 FROM IF_D4MDZ0300_MATLPLNT p
             WHERE p.TEN_ID = m.ten_id AND p.matnr = m.matnr
               AND p.werks IN ('LYA0', 'VYA0'))
  ) B
  ON (A.ten_id = #{g.tenant}
      AND A.oorg_cd = 'IOY1AO'
      AND A.item_cd = B.item_cd)
  WHEN MATCHED THEN
    UPDATE SET item_ldtm = 0
  WHEN NOT MATCHED THEN
    INSERT (ten_id, oorg_cd, item_cd, item_ldtm)
    VALUES (#{g.tenant}, 'IOY1AO', B.item_cd, 0)
</insert>