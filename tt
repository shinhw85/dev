				itemMap.putAll(matlMap);
				
				List<Map<String, Object>> matldescList = apiSapmdModelRepository.selectIF_D4MDZ0100_MATLDESC(matlMap);
				if(matldescList == null){
					LOG.debug("empty if statements");					
				}else{
					for(Map<String, Object> matldescMap : matldescList) {
						itemMap.put("maktx", matldescMap.get("maktx"));
