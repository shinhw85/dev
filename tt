// ApplicationConfiguration.java

// ===== MIGRATION-BEGIN (마이그레이션 종료 후 이 블록 삭제) =====
@Bean   // destroy 메서드는 MigrationSupport.shutdown() 이 자동으로 호출됨
public MigrationSupport migrationSupport(
        @Value("#{apiProperties['crypto.migration.enabled'] ?: 'false'}") boolean enabled,
        @Value("#{apiProperties['crypto.migration.passthrough.codes'] ?: ''}") String passCodes,
        @Value("#{apiProperties['crypto.migration.cipher.pattern'] ?: ''}") String cipherPattern,
        @Value("#{apiProperties['crypto.migration.report.minutes'] ?: '10'}") long reportMinutes) {
    return new MigrationSupport(enabled, passCodes, cipherPattern, reportMinutes);
}
// ===== MIGRATION-END =====

@Bean
public CryptoClient cryptoClient(@Lazy EgCryptoService eg,
                                 MigrationSupport migration) {          // MIGRATION: 종료 후 이 파라미터 삭제
    CryptoClient strict = new EgCryptoClient(eg);
    return migration.wrap(strict);                                      // MIGRATION: 종료 후 'return strict;' 로 교체
}

// import (종료 후 삭제): smartsuite.mybatis.migration.MigrationSupport
