			 , ZZREGTM
			 , ZZREGUS
			 , ZZAPPDT
			 , ZZAPPTM
			 , ZZAPPUS
			 , ZZLAMDT
			 , ZZLAMTM
			 , ZZLAMUS
			 , ZZPRFLG
			 , MTPOS_MARA
			 , NORMT
			 , WRKST
			 , ZZDATUV_M
			 , ZZVALTO
			 , ZZLKMAT
			 , BSTME
			 , ZZTAKLV
			 , ZZEHSYN
			 , MFRNR
			 , MFRPN
			 , ZZMDLNR
		  FROM IF_D4MDZ0300_MATL
		 WHERE TEN_ID = #{g.tenant}
		  AND TO_CHAR(REG_DTTM, 'YYYYMMDD') BETWEEN #{p.from_dt} AND #{p.to_dt}
