private static final int PAGE_SIZE = 1000; 

	public void callMatl(Map<String, Object> param) { 
	    String lastKey = null;
	    while (true) {
	        Map<String, Object> q = new HashMap<>(param);
	        q.put("pageSize", PAGE_SIZE);
	        q.put("lastKey", lastKey);

	        String nextKey = apiSapmdModelRepository.selectMatlPageLastKey(q);
	        if (nextKey == null) break;

	        txTemplate.executeWithoutResult(s -> {      // TransactionTemplate 주입
	            apiSapmdModelRepository.mergeModelVdNameBatch(q);
	            apiSapmdModelRepository.mergeModelBatch(q);
	            
	        });
	        lastKey = nextKey;
	    }
	    txTemplate.executeWithoutResult(s -> {
	    	apiSapmdModelRepository.mergeModelOorgBatch(param);
	    });
	}


 private static final int PAGE_SIZE = 1000;

    public void callEquip(Map<String, Object> param) {
        String lastKey = null;
        while (true) {
            Map<String, Object> q = new HashMap<>(param);
            q.put("pageSize", PAGE_SIZE);
            q.put("lastKey", lastKey);

            String nextKey = apiSapmdEquipRepository.selectEquipPageLastKey(q);
            if (nextKey == null) break;

            mergeEquipPage(q);
            lastKey = nextKey;
        }
        
        txTemplate.executeWithoutResult(s -> {
        	apiSapmdEquipRepository.mergeEquipOorgBatch(param);
	    });
    }

    @Transactional(rollbackFor = Exception.class)
    public void mergeEquipPage(Map<String, Object> q) {
    	apiSapmdEquipRepository.mergeEquipBatch(q);
    }
