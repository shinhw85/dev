WITH RECURSIVE dept_ancestor AS (
    SELECT dept_cd AS start_dept_cd, dept_cd, parent_dept_cd, a_yn, 1 AS depth
    FROM dept

    UNION ALL

    SELECT da.start_dept_cd, d.dept_cd, d.parent_dept_cd, d.a_yn, da.depth + 1
    FROM dept d
    JOIN dept_ancestor da ON d.dept_cd = da.parent_dept_cd
),
nearest_purchase AS (
    SELECT DISTINCT ON (start_dept_cd)
           start_dept_cd,
           dept_cd AS purchase_dept_cd
    FROM dept_ancestor
    WHERE a_yn = 'Y'
    ORDER BY start_dept_cd, depth
)
UPDATE users u
SET purchase_dept_cd = np.purchase_dept_cd
FROM nearest_purchase np
WHERE u.dept_cd = np.start_dept_cd;