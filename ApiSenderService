	static final Logger LOG = LoggerFactory.getLogger(ApiSenderService.class);

	private static final DateTimeFormatter DT_FMT = DateTimeFormatter.ofPattern("yyyyMMddHHmmssSSS");
	private static final long TOKEN_EXPIRY_BUFFER_MILLIS = 60_000L; // 60초 전 갱신
	private static final AtomicReference<SeqState> seqState = new AtomicReference<>(new SeqState(-1L, 0));
	
	private final ConcurrentHashMap<String, AtomicReference<TokenState>> tokenStateMap = new ConcurrentHashMap<>();
	
