	private Set<String> historySkipIds = Set.of();
	
	/**
	 * @param ifId 인터페이스 ID
	 * @param paramMap Map<String, Object>
	 * @return
	 */
	public Map<String, Object> call(String ifId, Map<String, Object> paramMap) {
		return this.call(ifId, paramMap, "EAI");
	}
	
	/**
	 * @param ifId
	 * @param paramMap
	 * @param targetSystem
	 * @return
	 */
	public Map<String, Object> call(String ifId, Map<String, Object> paramMap, String targetSystem) {
		Map<String, Object> resultMap = new HashMap();

		RestfulInput input = new RestfulInput();

		LOG.debug("=== I/F ID : " + ifId + "\nApiSenderService > call > reqParam : " + paramMap.toString());
		LocalDateTime startTime = LocalDateTime.now();
		
        Map<String, Object> lowerResultMap = new HashMap<String, Object>();
        String reqHeader = "";
        String reqBody = "";
        String reqBodyString = "";
        
        String resCode = "";
        String resMessage = "";
        String resDat = "";
        
        RestfulOutput output = new RestfulOutput();
        try {
        	// 헤더
            Map<String, String> header = new HashMap();
            header.put("Content-Type", MediaType.APPLICATION_JSON.toString());
            //  토큰 설정
            String accessToken = "";
            if("EG".equals(targetSystem.toUpperCase())) {
            	accessToken = getEgToken(ifId);
    		}else {
    			accessToken = getEaiToken(ifId);
    		}
            
            header.put("Authorization", "Bearer " + accessToken);
            input.setHeaders(header);

            // 바디
            // 공통
            if("EG".equals(targetSystem.toUpperCase())) {
            	input.setBody(paramMap);
    		}else {
    			paramMap.put("IS_HEADER", makeReq(ifId));           
    			
	            // param key 대문자 변환
	            Map<String, Object> upperMap = new HashMap<String, Object>();
	    		upperMap = JsonUtils.toUpperKeys(paramMap);
	            input.setBody(upperMap);
    		}
            
        	reqHeader = JsonUtils.getPrettyJson(objectMapper, input.getHeaders());
        	reqBody = JsonUtils.getPrettyJson(objectMapper, input.getBody());
        	reqBodyString = objectMapper.writeValueAsString(input.getBody());
	        // 호출
	        output = executeService.executeRestfulReactiveBlocking(ifId, input, ExecutionLevel.Production);

	        if(output.getStatusCode() == 200) {
	                /** 성공 */
		        	LOG.debug("\nI/F ID : {}" 
		        			+ "\n[REQ]"
		        			+ "\nHEADER: {}"
		        			+ "\nBODY: {}"
		        			+ "\n[RES]"
		        			+ "\nHEADER: {}"
		        			+ "\nBODY: {}"
		        			,ifId
		        			,reqHeader
		        			,reqBody
		        			,output.getHeaders().toString()
		        			,JsonUtils.getPrettyJson(objectMapper, output.getBodyAsString())
		        			);
                    resultMap = output.getBodyAsMap();
                    resDat = output.getBodyAsString();
                    
                    if("EG".equals(targetSystem.toUpperCase())) {
                    	resCode = ((Boolean) resultMap.get("result") == true) ? "S" : "E";
                    	
        				if(resultMap.get("value") instanceof List list) {
        					resMessage = list.toString();
        				}else if(resultMap.get("value") instanceof String str) {
        					resMessage = str;
        				}
        				
                    	lowerResultMap.putAll(resultMap);
                    	
            		}else {
            			// result key 소문자 변환
                        lowerResultMap = JsonUtils.toLowerKeys(resultMap);
	                    resCode = (String) ((Map<String, Object>) resultMap.get("ES_RETURN")).get("SAP_CODE");
	                    resMessage = (String) ((Map<String, Object>) resultMap.get("ES_RETURN")).get("MESSAGE");
                    }
                    
	        }else {
	            /** 실패 */
	        	LOG.debug("\nRestful API 실패"
	        			+ "\nI/F ID : {}" 
						+ "\nStatus Code: {}"
						+ "\nException Message: {}"
						,ifId
						,output.getStatusCode()
						,output.getException().getMessage()
						);
	        	resCode = "F";
	        	resMessage = output.getException().getMessage();
	        }
        } catch (Exception e) {
        	LOG.debug("\nRestful API 실패"
        			+ "\nI/F ID : {}"
        			+ "\nException Message: {}"
        			+ "\n[REQ]"
					+ "\nHEADER: {}"
					+ "\nBODY: {}"
					,ifId
					,e.getMessage()
					,reqHeader
					,reqBody
					);
        	resCode = "E";
        	resMessage = e.getMessage();
        	
            return null;
        } finally {
        	LocalDateTime endTime = LocalDateTime.now();
        	Map<String, Object> hisMap = new HashMap<String, Object>();
        	hisMap.put("if_id", ifId);
        	hisMap.put("exec_st_dttm", startTime.format(DT_FMT));
        	hisMap.put("exec_end_dttm", endTime.format(DT_FMT));
        	hisMap.put("exec_tm", Duration.between(startTime, endTime).toMillis() / 1000.0);
        	hisMap.put("req_dat", reqBodyString);
        	//hisMap.put("res_dat", output.getBodyAsString());
        	hisMap.put("res_dat", resDat);
        	hisMap.put("res_code", resCode);
        	hisMap.put("res_message", resMessage);
        	hisMap.put("snd_rcpt_type", "S");
        	
        	String ip = "";
    		ServletRequestAttributes attributes = (ServletRequestAttributes)RequestContextHolder.getRequestAttributes();
    		if(attributes != null) {
    			HttpServletRequest request = attributes.getRequest();
    			if(request != null) {
    				ip = accountService.getClientIpAddress(request);
    			}
    		}
    		hisMap.put("ip_address", ip);
    		
			apiSenderRepository.insertIfHistory(hisMap);
		}
        return lowerResultMap;
	}
	

	private ApiCommon makeReq(String ifId) {
		// 공통 REQ 추가

        String[] idArr = ifId.split("_");
        String sendSystem = idArr[1];
		String receiveSystem = idArr[2];

		String curTime = LocalDateTime.now().format(DT_FMT);
		String datetimeSeq =  generateDtSeq();

        StringBuffer sb = new StringBuffer();
        sb.append(sendSystem)
        .append("_")
        .append(receiveSystem)
        .append("_")
        .append(datetimeSeq);
        String id = sb.toString();

        int txSeq = apiSenderRepository.nextTxSeq();


        ApiCommon eaiCommon = new ApiCommon();
        eaiCommon.setTransactionId("TX_" + id);
        eaiCommon.setTxSeq(String.format("%06d", txSeq % 1_000_000));
        eaiCommon.setInterfaceId(ifId);
        eaiCommon.setCorrelaionid("CORR_" + id);
        eaiCommon.setReprocessid("RP_" + id);
        eaiCommon.setSendSystem(Const.EAI_SRM_SYSTEM);
        eaiCommon.setReceiveSystem(receiveSystem);
        eaiCommon.setSapDatetime(curTime);
        eaiCommon.setSapCode("N");
        eaiCommon.setSysKey("S1SRM");

        return eaiCommon;
	}

	private static final class SeqState {
	    final long timestamp;
	    final int sequence;
	    SeqState(long timestamp, int sequence) {
	        this.timestamp = timestamp;
	        this.sequence = sequence;
	    }
	}

	private String generateDtSeq() {
	    long now = System.currentTimeMillis();
	    SeqState next = seqState.updateAndGet(prev ->
	        (now == prev.timestamp)
	            ? new SeqState(now, (prev.sequence + 1) % 1000)
	            : new SeqState(now, 1)
	    );

	    String timestamp = Instant.ofEpochMilli(next.timestamp)
	            .atZone(ZoneId.systemDefault())
	            .format(DT_FMT);
	    return timestamp + "_" + String.format("%03d", next.sequence);
	}
	
	private String getEgToken(String ifId) throws Exception {
		String receiveSystem = "EG";
		AtomicReference<TokenState> tokenRef = tokenStateMap.computeIfAbsent(receiveSystem, k -> new AtomicReference<>(new TokenState(null, 0L)));

		long now = System.currentTimeMillis();
		TokenState current = tokenRef.get();
		
		if(current.isValid(now)) {
			return current.accessToken;
		}
		
		synchronized (tokenRef) {
			current = tokenRef.get();
			if(current.isValid(now)) {
				return current.accessToken;
			}
			
			// ifId를 이용해서 포트를 구한 다음에 직접 토큰 가져오는 로직 구현
			String addr = apiSenderRepository.selectRestfulAddress(ifId);
			
			HttpHeaders headers = new HttpHeaders();
			headers.setContentType(MediaType.APPLICATION_JSON);
			
			Map<String, String> body = new HashMap<String, String>();
			body.put("username", egUsername);
			body.put("password", egPassword);
			
			HttpEntity<Map<String, String>> request = new HttpEntity<>(body, headers);
			try {
				ResponseEntity<String> response = restTemplate.exchange(
						addr+egToken,
						HttpMethod.POST,
						request,
						String.class
						);
				Map<String, Object> tokenMap = objectMapper.readValue(response.getBody(), new TypeReference<Map<String, Object>>(){});
				
				if(((Boolean) tokenMap.get("result") == true)) {
					String accessToken = (String) tokenMap.get("value");
					Number expiresIn = (Number) egExpiresIn;
					
					long expiresAt = (expiresIn != null)
							? now + expiresIn.longValue() * 1000L - TOKEN_EXPIRY_BUFFER_MILLIS
							: now + 3600_000L; //EG 최소 Expire Time 1시간 
					tokenRef.set(new TokenState(accessToken, expiresAt));
					return accessToken;
				}else {
					throw new Exception((String) tokenMap.get("value"));
				}
				
			}catch(Exception e) {
				LOG.warn("EG 토큰 발급 실패 : {}", e.getMessage());
				throw new Exception("EG 토큰 발급 실패");
			}
		}
	}
	
	private String getEaiToken(String ifId) throws Exception {
		String[] idArr = ifId.split("_");
		String receiveSystem = idArr[2];
		AtomicReference<TokenState> tokenRef = tokenStateMap.computeIfAbsent(receiveSystem, k -> new AtomicReference<>(new TokenState(null, 0L)));

		long now = System.currentTimeMillis();
		TokenState current = tokenRef.get();
		
		if(current.isValid(now)) {
			return current.accessToken;
		}
		
		synchronized (tokenRef) {
			current = tokenRef.get();
			if(current.isValid(now)) {
				return current.accessToken;
			}
			
			// ifId를 이용해서 포트를 구한 다음에 직접 토큰 가져오는 로직 구현
			String addr = apiSenderRepository.selectRestfulAddress(ifId);
			
			HttpHeaders headers = new HttpHeaders();
			headers.setContentType(MediaType.APPLICATION_FORM_URLENCODED);
			MultiValueMap<String, String> body = new LinkedMultiValueMap<String, String>();
			body.add("grant_type", "client_credentials");
			body.add("client_id", eaiClientId);
			body.add("client_secret", eaiClientSecret);
			
			HttpEntity<MultiValueMap<String, String>> request = new HttpEntity<>(body, headers);
			try {
				ResponseEntity<String> response = restTemplate.exchange(
						addr+"/oauth/token",
						HttpMethod.POST,
						request,
						String.class
						);
				Map<String, Object> tokenMap = objectMapper.readValue(response.getBody(), new TypeReference<Map<String, Object>>(){});
				String accessToken = (String) tokenMap.get("access_token");
				Number expiresIn = (Number) tokenMap.get("expires_in");
				
				long expiresAt = (expiresIn != null)
						? now + expiresIn.longValue() * 1000L - TOKEN_EXPIRY_BUFFER_MILLIS
						: now + 60_000L;
				tokenRef.set(new TokenState(accessToken, expiresAt));
				return accessToken;
			}catch(Exception e) {
				LOG.warn("EAI 토큰 발급 실패", e.getMessage());
				throw new Exception("EAI 토큰 발급 실패");
			}
		}
	}

	private static final class TokenState {
		final String accessToken;
		final long expiresAtMillis;
		
		TokenState(String accessToken, long expiresAtMillis){
			this.accessToken = accessToken;
			this.expiresAtMillis = expiresAtMillis;
		}
		
		boolean isValid(long nowMillis) {
			return accessToken != null && nowMillis < expiresAtMillis;
		}
	}



}
