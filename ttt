powershell -ExecutionPolicy Bypass -File check_deps.ps1 -Lib C:\temp\libs

param([string]$Lib)
Add-Type -AssemblyName System.IO.Compression.FileSystem

$jars = Get-ChildItem $Lib -Filter *.jar
$have = New-Object System.Collections.Generic.HashSet[string]
foreach ($j in $jars) { [void]$have.Add(($j.BaseName -replace '-\d[\w\.\-]*$','')) }

$result = foreach ($j in $jars) {
  $zip = [IO.Compression.ZipFile]::OpenRead($j.FullName)
  foreach ($e in $zip.Entries) {
    if ($e.FullName -like 'META-INF/maven/*/pom.xml') {
      $sr = New-Object IO.StreamReader($e.Open())
      [xml]$x = $sr.ReadToEnd(); $sr.Close()
      foreach ($d in $x.project.dependencies.dependency) {
        $scope = if ($d.scope) { $d.scope } else { 'compile' }
        if (($scope -in 'compile','runtime') -and $d.optional -ne 'true' -and -not $have.Contains($d.artifactId)) {
          "$($d.groupId):$($d.artifactId) <- $($j.Name)"
        }
      }
    }
  }
  $zip.Dispose()
}
$result | Sort-Object -Unique