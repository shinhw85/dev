package smartsuite.mybatis;

import java.util.ArrayList;
import java.util.List;

import smartsuite.app.crypto.EgCryptoService;

/**
 * EgCryptoService를 CryptoClient로 감싸는 얇은 어댑터. (List 그대로 전달, 변환/복사 없음)
 * - 한 번에 보낼 수 있는 건수 제한이 있으면 CHUNK 단위로 나눠 호출 (subList 뷰라 복사 없음)
 * - checked Exception은 런타임 예외로 감싸 전파 (실패 시 평문 저장/반환 방지)
 */
public class EgCryptoClient implements CryptoClient {

    private static final int CHUNK = 500;   // TODO: EG 1회 호출 허용 건수에 맞게 조정

    private final EgCryptoService eg;

    public EgCryptoClient(EgCryptoService eg) {
        this.eg = eg;
    }

    @Override
    public List<String> encrypt(List<String> plains) {
        return run(plains, true);
    }

    @Override
    public List<String> decrypt(List<String> ciphers) {
        return run(ciphers, false);
    }

    private List<String> run(List<String> in, boolean encrypt) {
        if (in.isEmpty()) {
            return in;
        }
        try {
            if (in.size() <= CHUNK) {
                return encrypt ? eg.enc(in) : eg.dec(in);
            }
            List<String> out = new ArrayList<>(in.size());
            for (int from = 0; from < in.size(); from += CHUNK) {
                List<String> part = in.subList(from, Math.min(from + CHUNK, in.size()));
                out.addAll(encrypt ? eg.enc(part) : eg.dec(part));
            }
            return out;
        } catch (RuntimeException e) {
            throw e;
        } catch (Exception e) {
            throw new IllegalStateException("EG 암복호화 실패(" + (encrypt ? "enc" : "dec") + ")", e);
        }
    }
}
