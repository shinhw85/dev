	<!-- 	벤더 인터페이스 받아서 ESMVDGL 테이블에 merge로 처리 -->
	<!-- ENC_VARCHAR2_INS 관련 : 운영과 암호화 키가 다르므로 프로그램 변경/반영시 유의할 것	 -->
<!-- 	<update id="mergeVendor" parameterType="map"> -->
<!-- 	/*	D4MDZ0500.mergeVendor :  벤더 인터페이스 받아서 ESMVDGL 테이블에 merge로 처리	*/ -->
<!-- 		MERGE INTO ESMVDGL# A -->
<!-- 		USING -->
<!-- 		(SELECT  TO_NUMBER(#{p.zzsrmcd}) AS ZZSRMCD, -->
